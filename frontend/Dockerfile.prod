# ===========================================
# Stage 1: Build
# ===========================================
FROM node:20-alpine AS builder

WORKDIR /app

# 패키지 파일 복사 및 의존성 설치
COPY package.json ./
RUN npm install

# 앱 코드 복사
COPY . .

# 빌드 인자로 API URL 받기
ARG VITE_API_BASE_URL=https://prompt.shoneylife.com/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# 프로덕션 빌드
RUN npm run build

# ===========================================
# Stage 2: Production (nginx로 정적 파일 서빙)
# ===========================================
FROM nginx:alpine

# 빌드된 파일 복사
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx 설정은 docker-compose에서 볼륨 마운트로 처리

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
